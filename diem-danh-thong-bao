import tkinter as tk
from tkinter import messagebox, ttk

# Tạo cửa sổ ứng dụng chính
root = tk.Tk()
root.title("Phần mềm Quản lý Lớp học Thêm - Điểm danh & Thông báo")
root.geometry("650x650")

# --- TIÊU ĐỀ ỨNG DỤNG ---
title_label = tk.Label(root, text="HỆ THỐNG QUẢN LÝ LỚP HỌC THÊM", font=("Arial", 16, "bold"), fg="#2c3e50")
title_label.pack(pady=10)

# ================= MỤC 1: QUẢN LÝ ĐIỂM DANH =================
frame_diem_danh = tk.LabelFrame(root, text=" 1. Quản lý Điểm danh Học viên ", font=("Arial", 11, "bold"), padx=10, pady=10)
frame_diem_danh.pack(fill="both", expand="yes", padx=15, pady=5)

# Chọn lớp học
tk.Label(frame_diem_danh, text="Chọn lớp học:").grid(row=0, column=0, sticky="w", pady=5)
class_combobox = ttk.Combobox(frame_diem_danh, values=["Lớp Toán 10 - Ca 1", "Lớp Tiếng Anh 11 - Ca 2"], width=30)
class_combobox.grid(row=0, column=1, sticky="w", pady=5)
class_combobox.current(0)

# Danh sách học viên và trạng thái điểm danh (Giả lập danh sách)
tk.Label(frame_diem_danh, text="Danh sách học viên:", font=("Arial", 10, "italic")).grid(row=1, column=0, sticky="w", pady=5)

students = [
    ("HV001", "Nguyễn Văn A"),
    ("HV002", "Trần Thị B"),
    ("HV003", "Lê Hoàng C")
]

attendance_vars = []

for idx, (ma_hv, ten_hv) in enumerate(students):
    row_num = 2 + idx
    tk.Label(frame_diem_danh, text=f"{ma_hv} - {ten_hv}").grid(row=row_num, column=0, sticky="w", padx=10)
    
    # Biến lưu trạng thái (1: Có mặt, 2: Vắng có phép, 3: Vắng không phép)
    var = tk.IntVar(value=1)
    attendance_vars.append(var)
    
    frame_radio = tk.Frame(frame_diem_danh)
    frame_radio.grid(row=row_num, column=1, sticky="w", pady=2)
    
    tk.Radiobutton(frame_radio, text="Có mặt", variable=var, value=1).pack(side="left", padx=5)
    tk.Radiobutton(frame_radio, text="Vắng (Có phép)", variable=var, value=2).pack(side="left", padx=5)
    tk.Radiobutton(frame_radio, text="Vắng (Không phép)", variable=var, value=3).pack(side="left", padx=5)

# Nút lưu điểm danh
def save_attendance():
    selected_class = class_combobox.get()
    messagebox.showinfo("Thành công", f"Đã lưu điểm danh cho {selected_class} thành công!")

btn_save = tk.Button(frame_diem_danh, text="Lưu danh sách điểm danh", bg="#27ae60", fg="white", font=("Arial", 10, "bold"), command=save_attendance)
btn_save.grid(row=5, column=0, columnspan=2, pady=10)


# ================= MỤC 2: QUẢN LÝ THÔNG BÁO =================
frame_thong_bao = tk.LabelFrame(root, text=" 2. Gửi Thông báo cho Phụ huynh & Học viên ", font=("Arial", 11, "bold"), padx=10, pady=10)
frame_thong_bao.pack(fill="both", expand="yes", padx=15, pady=5)

# Người nhận
tk.Label(frame_thong_bao, text="Đối tượng nhận:").grid(row=0, column=0, sticky="w", pady=5)
recipient_combobox = ttk.Combobox(frame_thong_bao, values=["Tất cả học viên trong lớp", "Chỉ gửi phụ huynh học viên vắng mặt"], width=30)
recipient_combobox.grid(row=0, column=1, sticky="w", pady=5)
recipient_combobox.current(0)

# Tiêu đề thông báo
tk.Label(frame_thong_bao, text="Tiêu đề thông báo:").grid(row=1, column=0, sticky="w", pady=5)
entry_title = tk.Entry(frame_thong_bao, width=33)
entry_title.grid(row=1, column=1, sticky="w", pady=5)

# Nội dung thông báo
tk.Label(frame_thong_bao, text="Nội dung chi tiết:").grid(row=2, column=0, sticky="nw", pady=5)
text_content = tk.Text(frame_thong_bao, width=32, height=4)
text_content.grid(row=2, column=1, sticky="w", pady=5)

# Nút gửi thông báo
def send_notification():
    title = entry_title.get()
    if not title:
        messagebox.showwarning("Cảnh báo", "Vui lòng nhập tiêu đề thông báo!")
    else:
        messagebox.showinfo("Thành công", "Đã gửi thông báo đến hệ thống thành công!")

btn_send = tk.Button(frame_thong_bao, text="Gửi Thông báo", bg="#e67e22", fg="white", font=("Arial", 10, "bold"), command=send_notification)
btn_send.grid(row=3, column=0, columnspan=2, pady=10)

# Chạy ứng dụng
root.mainloop()